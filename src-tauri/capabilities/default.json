{
  "$schema": "../gen/schemas/macOS-schema.json",
  "identifier": "default",
  "description": "Default capabilities for PageSmith",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:default",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file"
  ]
}
